import { Button, CheckBox, LineEdit, ScrollView, Palette } from "std-widgets.slint";

export struct TaskRow {
    id: string,
    name: string,
    state: string,
    hotkey: string,
    target: string,
    interval: string,
    button: string,
    limit: string,
    color: string,
    clicks: string,
    running: bool,
    builtin: bool,
    include-in-batch: bool,
}

component ActionButton inherits Button {
    in property <string> label;
    text: root.label;
    preferred-height: 36px;
}

component Field inherits VerticalLayout {
    in property <string> label;
    in property <string> hint: "";
    in property <string> placeholder: "";
    in-out property <string> value;
    spacing: 6px;
    Text { text: root.label; color: Palette.foreground; font-size: 12px; }
    LineEdit {
        text <=> root.value;
        placeholder-text: root.placeholder;
        accessible-label: root.label;
        preferred-height: 36px;
    }
    if root.hint != "": Text { text: root.hint; font-size: 11px; color: Palette.foreground; opacity: 0.7; wrap: word-wrap; }
}

export component AppWindow inherits Window {
    title: "Pointory · 鼠标自动点击器";
    preferred-width: 1080px;
    preferred-height: 700px;
    min-width: 920px;
    min-height: 560px;
    background: Palette.background;
    default-font-size: 13px;

    in-out property <[TaskRow]> task-rows: [];
    in-out property <string> active-count: "0";
    in-out property <string> status-message: "就绪。点击运行，或按任务快捷键开始 / 停止。";
    in-out property <string> hotkey-warning: "";
    in-out property <bool> editor-open: false;
    in-out property <bool> simple-editor: false;
    in-out property <bool> is-new: false;
    in-out property <string> editor-error: "";
    in-out property <string> task-name: "";
    in-out property <string> target-x: "";
    in-out property <string> target-y: "";
    in-out property <string> color-hex: "";
    in-out property <string> tolerance: "12";
    in-out property <string> minimum-interval: "1000";
    in-out property <string> maximum-interval: "0";
    in-out property <string> hotkey: "";
    in-out property <string> maximum-clicks: "0";
    in-out property <string> mouse-button: "左键";
    in-out property <bool> match-color: false;
    in-out property <bool> include-in-batch: false;
    in-out property <bool> picker-active: false;
    in-out property <bool> delete-open: false;
    in-out property <string> delete-name: "";
    private property <bool> list-enabled: !editor-open && !delete-open;

    callback add-task();
    callback edit-task(string);
    callback toggle-task(string);
    callback delete-task(string);
    callback confirm-delete();
    callback cancel-delete();
    callback save-task();
    callback cancel-editor();
    callback run-batch();
    callback stop-all();
    callback pick-position();
    callback pick-color();
    callback cancel-picker();
    callback cycle-button();

    VerticalLayout {
        padding: 26px;
        spacing: 20px;
        HorizontalLayout {
            height: 52px;
            spacing: 12px;
            Rectangle {
                width: 42px; height: 42px; border-radius: 12px; background: Palette.accent-background;
                Text { text: "P"; color: Palette.accent-foreground; font-size: 24px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
            }
            VerticalLayout {
                spacing: 3px;
                Text { text: "Pointory"; font-size: 21px; font-weight: 700; color: Palette.foreground; }
                Text { text: "鼠标自动点击器"; font-size: 11px; color: Palette.foreground; }
            }
            Rectangle { horizontal-stretch: 1; }
            ActionButton { label: "批量运行"; width: 92px; enabled: root.list-enabled; clicked => { root.run-batch(); } }
            ActionButton { label: "全部停止"; width: 92px; enabled: root.list-enabled; clicked => { root.stop-all(); } }
            ActionButton { label: "+  添加任务"; width: 116px; primary: true; enabled: root.list-enabled; clicked => { root.add-task(); } }
        }
        HorizontalLayout {
            height: 26px;
            spacing: 10px;
            Text { text: "任务列表"; font-size: 17px; font-weight: 700; color: Palette.foreground; vertical-alignment: center; }
            Text { text: root.task-rows.length + " 项任务"; font-size: 11px; color: Palette.foreground; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
            Rectangle {
                width: 8px; height: 8px; border-radius: 4px; background: root.active-count == "0" ? Palette.foreground : Palette.accent-background;
            }
            Text { text: root.active-count + " 项运行中"; color: Palette.foreground; font-size: 12px; vertical-alignment: center; }
        }
        Rectangle {
            border-radius: 12px;
            background: Palette.background;
            border-color: Palette.border;
            border-width: 1px;
            VerticalLayout {
                spacing: 0px;
                Rectangle {
                    height: 42px;
                    background: Palette.alternate-background;
                    HorizontalLayout {
                        padding-left: 18px; padding-right: 18px; spacing: 20px;
                        Text { text: "任务 / 基本信息"; color: Palette.foreground; font-size: 11px; vertical-alignment: center; horizontal-stretch: 1; }
                        Text { text: "点击间隔"; width: 110px; color: Palette.foreground; font-size: 11px; vertical-alignment: center; }
                        Text { text: "快捷键"; width: 112px; color: Palette.foreground; font-size: 11px; vertical-alignment: center; }
                        Text { text: "状态 / 点击数"; width: 124px; color: Palette.foreground; font-size: 11px; vertical-alignment: center; }
                        Text { text: "操作"; width: 210px; color: Palette.foreground; font-size: 11px; vertical-alignment: center; }
                    }
                }
                ScrollView {
                    content-width: self.visible-width;
                    VerticalLayout {
                        spacing: 0px;
                        alignment: start;
                        for task in root.task-rows: Rectangle {
                            height: 116px;
                            background: task.running ? Palette.alternate-background : Palette.background;
                            Rectangle { y: parent.height - 1px; height: 1px; background: Palette.border; }
                            HorizontalLayout {
                                padding-left: 18px; padding-right: 18px; padding-top: 17px; padding-bottom: 17px; spacing: 20px;
                                VerticalLayout {
                                    spacing: 7px;
                                    horizontal-stretch: 1;
                                    HorizontalLayout {
                                        spacing: 7px;
                                        Text { text: task.name; color: Palette.foreground; font-size: 14px; font-weight: 600; overflow: elide; horizontal-stretch: 1; }
                                        if task.builtin: Rectangle {
                                            width: 34px; height: 19px; background: Palette.alternate-background; border-radius: 4px;
                                            Text { text: "内置"; font-size: 10px; color: Palette.foreground; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                    }
                                    Text { text: task.button + " · " + task.target; color: Palette.foreground; font-size: 11px; overflow: elide; }
                                    Text { text: task.limit + (task.color == "" ? "" : " · " + task.color) + (task.include-in-batch ? " · 批量" : ""); color: Palette.foreground; font-size: 10px; overflow: elide; }
                                }
                                VerticalLayout {
                                    width: 110px; spacing: 5px; alignment: center;
                                    Text { text: task.interval; color: Palette.foreground; font-size: 12px; wrap: word-wrap; }
                                }
                                VerticalLayout {
                                    width: 112px; alignment: center;
                                    Text { text: task.hotkey == "" ? "未设置" : task.hotkey; color: Palette.foreground; font-size: 12px; wrap: word-wrap; }
                                }
                                VerticalLayout {
                                    width: 124px; spacing: 6px; alignment: center;
                                    Text { text: task.state; color: task.running ? Palette.accent-background : Palette.foreground; font-size: 12px; wrap: word-wrap; }
                                    Text { text: "已点击 " + task.clicks + " 次"; color: Palette.foreground; font-size: 10px; }
                                }
                                HorizontalLayout {
                                    width: 210px; spacing: 7px; alignment: start;
                                    ActionButton { label: task.running ? "停止" : "运行"; width: 66px; primary: !task.running; enabled: root.list-enabled; clicked => { root.toggle-task(task.id); } }
                                    ActionButton { label: "编辑"; width: 62px; enabled: root.list-enabled && !task.running; clicked => { root.edit-task(task.id); } }
                                    if !task.builtin: ActionButton { label: "删除"; width: 62px; enabled: root.list-enabled && !task.running; clicked => { root.delete-task(task.id); } }
                                }
                            }
                        }
                    }
                }
            }
        }
        VerticalLayout {
            spacing: 9px;
            Text { text: root.status-message; color: Palette.foreground; font-size: 12px; wrap: word-wrap; }
            if root.hotkey-warning != "": Text { text: root.hotkey-warning; color: Palette.foreground; font-size: 11px; wrap: word-wrap; }
            Text { text: "任务快捷键：开始 / 停止     ·     Ctrl + Alt + Esc：全部停止     ·     批量运行：启动已加入批量的任务"; color: Palette.foreground; font-size: 11px; wrap: word-wrap; }
        }
    }

    if root.editor-open: Rectangle {
        background: transparent;
        Rectangle { background: Palette.foreground; opacity: 0.18; TouchArea { } }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: root.simple-editor ? 440px : 740px;
            height: min(parent.height - 36px, root.simple-editor ? 380px : 650px);
            background: Palette.alternate-background;
            border-radius: 14px;
            border-width: 1px;
            border-color: Palette.border;
            FocusScope {
                init => { self.focus(); }
                capture-key-pressed(event) => {
                    if (event.text == Key.Escape) {
                        if (root.picker-active) { root.cancel-picker(); } else { root.cancel-editor(); }
                        return accept;
                    }
                    return reject;
                }
                VerticalLayout {
                    padding: 22px; spacing: 16px;
                    HorizontalLayout {
                        height: 36px;
                        Text { text: root.simple-editor ? "设置鼠标连点器" : root.is-new ? "添加任务" : "编辑任务"; color: Palette.foreground; font-size: 18px; font-weight: 700; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; }
                        ActionButton { label: "关闭"; width: 64px; preferred-height: 32px; clicked => { root.cancel-editor(); } }
                    }
                    if root.simple-editor: VerticalLayout {
                        spacing: 16px;
                        Text { text: "跟随鼠标当前位置，持续点击左键。"; color: Palette.foreground; font-size: 12px; }
                        Field { label: "点击间隔（毫秒）"; value <=> root.minimum-interval; hint: "范围：20–86400000 毫秒"; }
                        Field { label: "开始 / 停止快捷键"; value <=> root.hotkey; placeholder: "F1"; }
                    }
                    if !root.simple-editor: ScrollView {
                        content-width: self.visible-width;
                        VerticalLayout {
                            padding-right: 8px; spacing: 15px;
                            Field { label: "任务名称"; value <=> root.task-name; placeholder: "为任务起一个便于辨认的名称"; }
                            HorizontalLayout {
                                spacing: 14px;
                                Field { label: "最短间隔（毫秒）"; value <=> root.minimum-interval; }
                                Field { label: "最长间隔（0 = 固定）"; value <=> root.maximum-interval; }
                                Field { label: "点击次数（0 = 持续）"; value <=> root.maximum-clicks; }
                            }
                            HorizontalLayout {
                                spacing: 14px;
                                VerticalLayout {
                                    width: 150px; spacing: 6px;
                                    Text { text: "鼠标按键"; color: Palette.foreground; font-size: 12px; }
                                    ActionButton { label: root.mouse-button + "  ·  切换"; preferred-height: 38px; width: 150px; clicked => { root.cycle-button(); } }
                                }
                                Field { label: "开始 / 停止快捷键"; value <=> root.hotkey; placeholder: "例如 CTRL+ALT+F6；可留空"; }
                            }
                            Rectangle { height: 1px; background: Palette.border; }
                            HorizontalLayout {
                                spacing: 10px;
                                Text { text: "固定点击位置"; color: Palette.foreground; font-size: 12px; vertical-alignment: center; }
                                Rectangle { horizontal-stretch: 1; }
                                ActionButton { label: "位置取点"; width: 90px; preferred-height: 32px; clicked => { root.pick-position(); } }
                            }
                            HorizontalLayout {
                                spacing: 14px;
                                Field { label: "X 坐标"; value <=> root.target-x; }
                                Field { label: "Y 坐标"; value <=> root.target-y; }
                            }
                            Text { text: "位置取点或吸取颜色时会最小化主窗口，移动鼠标后点击左键确认，Esc 取消。"; color: Palette.foreground; opacity: 0.7; font-size: 11px; wrap: word-wrap; }
                            HorizontalLayout {
                                spacing: 10px;
                                CheckBox { text: "仅颜色匹配时点击"; checked <=> root.match-color; }
                                Rectangle { horizontal-stretch: 1; }
                                ActionButton { label: "吸取颜色"; width: 86px; preferred-height: 32px; clicked => { root.pick-color(); } }
                            }
                            if root.match-color: HorizontalLayout {
                                spacing: 14px;
                                Field { label: "目标颜色（#RRGGBB）"; value <=> root.color-hex; placeholder: "#FFFFFF"; }
                                Field { label: "颜色容差（0–255）"; value <=> root.tolerance; }
                            }
                            CheckBox { text: "加入批量运行"; checked <=> root.include-in-batch; }
                        }
                    }
                    if root.editor-error != "": Text { text: root.editor-error; color: Palette.foreground; font-size: 12px; wrap: word-wrap; }
                    HorizontalLayout {
                        spacing: 10px;
                        Rectangle { horizontal-stretch: 1; }
                        ActionButton { label: "取消"; width: 84px; clicked => { root.cancel-editor(); } }
                        ActionButton { label: root.is-new ? "添加任务" : "保存"; primary: true; width: 100px; enabled: !root.picker-active; clicked => { root.save-task(); } }
                    }
                }
            }
        }
    }

    if root.delete-open: Rectangle {
        background: transparent;
        Rectangle { background: Palette.foreground; opacity: 0.18; TouchArea { } }
        Rectangle {
            width: 420px; height: 210px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Palette.alternate-background; border-radius: 14px; border-width: 1px; border-color: Palette.border;
            FocusScope {
                init => { self.focus(); }
                capture-key-pressed(event) => {
                    if (event.text == Key.Escape) { root.cancel-delete(); return accept; }
                    return reject;
                }
                VerticalLayout {
                    padding: 24px; spacing: 18px;
                    Text { text: "删除任务"; color: Palette.foreground; font-size: 18px; font-weight: 700; }
                    Text { text: "确认删除“" + root.delete-name + "”？"; color: Palette.foreground; font-size: 13px; overflow: elide; }
                    HorizontalLayout {
                        spacing: 10px;
                        Rectangle { horizontal-stretch: 1; }
                        ActionButton { label: "取消"; width: 84px; clicked => { root.cancel-delete(); } }
                        ActionButton { label: "确认删除"; width: 100px; clicked => { root.confirm-delete(); } }
                    }
                }
            }
        }
    }
}

export component NoticeWindow inherits Window {
    title: "Pointory";
    preferred-width: 440px;
    preferred-height: 220px;
    min-width: 400px;
    min-height: 220px;
    background: Palette.alternate-background;
    in property <string> message;
    callback dismiss();
    FocusScope {
        init => { close-button.focus(); }
        capture-key-pressed(event) => {
            if (event.text == Key.Escape || event.text == Key.Return) {
                root.dismiss();
                return accept;
            }
            return reject;
        }
        VerticalLayout {
            padding: 24px;
            spacing: 18px;
            Text { text: "Pointory"; color: Palette.foreground; font-size: 18px; font-weight: 700; }
            Text { text: root.message; color: Palette.foreground; font-size: 13px; wrap: word-wrap; vertical-stretch: 1; }
            HorizontalLayout {
                Rectangle { horizontal-stretch: 1; }
                close-button := ActionButton { label: "关闭"; width: 90px; primary: true; clicked => { root.dismiss(); } }
            }
        }
    }
}

export component MagnifierWindow inherits Window {
    title: "Pointory · 屏幕取样";
    width: 208px;
    height: 210px;
    no-frame: true;
    always-on-top: true;
    background: Palette.background;
    default-font-size: 12px;
    in property <string> preview-position;
    in property <image> magnifier-image;
    in property <string> error-message: "";
    Rectangle {
        border-width: 1px;
        border-color: Palette.border;
        background: Palette.background;
        VerticalLayout {
            padding: 10px;
            spacing: 6px;
            HorizontalLayout {
                Rectangle { horizontal-stretch: 1; }
                Image { source: root.magnifier-image; width: 136px; height: 136px; image-fit: contain; }
                Rectangle { horizontal-stretch: 1; }
            }
            Text { text: root.preview-position; color: Palette.foreground; font-size: 11px; horizontal-alignment: center; overflow: elide; }
            Text { text: root.error-message == "" ? "左键确认 · Esc 取消" : root.error-message; color: Palette.foreground; font-size: 11px; horizontal-alignment: center; wrap: word-wrap; }
        }
    }
}
